{
  "builds": [
    {
      "src": "Frontend/package.json",
      "use": "@vercel/angular"
    },
    {
      "src": "backend/app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/app.py"
    },
    {
      "src": "/(.*)",
      "dest": "RENEWLY/Frontend/$1"
    }
  ]
}
